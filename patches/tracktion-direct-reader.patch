     /// AudioFormatReaderWithTimeout for it. Returns nullptr otherwise.
     std::unique_ptr<AudioFormatReaderWithTimeout> createMemoryReader (const AudioFile&) const;
 
+    /// Mixtopia patch (tracktion-direct-reader.patch): an optional hook that supplies a reader for a
+    /// file to be read directly, like a memory buffer, instead of through the background-buffered
+    /// path Tracktion uses for files it can't memory-map (which can return silence for a moment
+    /// after playback starts or jumps). Return nullptr for files it doesn't handle.
+    std::function<std::unique_ptr<AudioFormatReaderWithTimeout> (const juce::File&)> createDirectReader;
+
+    /// Mixtopia patch: true for the files createDirectReader handles. They're treated like WAVs (no
+    /// cached proxy, no BufferedFileReader path in WaveNodeRealTime), so every read goes through
+    /// the direct reader.
+    std::function<bool (const juce::File&)> isReadDirectly;
